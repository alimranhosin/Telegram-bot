DB_NAME = "gmail_bot.db"


def init_db():
  conn = sqlite3.connect(DB_NAME)
  cursor = conn.cursor()

  # জিমেইল জমার টেবিল
  cursor.execute("""
        CREATE TABLE IF NOT EXISTS gmail_submissions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            username TEXT,
            email TEXT UNIQUE,
            password TEXT,
            status TEXT DEFAULT 'Pending',
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)

  # ইউজারের ব্যালেন্স ও রেফারাল টেবিল
  cursor.execute("""
        CREATE TABLE IF NOT EXISTS user_balances (
            user_id INTEGER PRIMARY KEY,
            balance REAL DEFAULT 0.0,
            referred_by INTEGER DEFAULT NULL
        )
    """)

  conn.commit()
  conn.close()


def add_user_and_process_referral(user_id, referrer_id=None):
  """নতুন ইউজার যুক্ত করা এবং রেফার করা ব্যক্তিকে অটো বোনাস দেওয়া"""
  conn = sqlite3.connect(DB_NAME)
  cursor = conn.cursor()

  cursor.execute(
      "SELECT user_id FROM user_balances WHERE user_id = ?", (user_id,)
  )
  user = cursor.fetchone()

  rewarded_referrer = None

  if not user:
    # নতুন ইউজারকে ডাটাবেসে যোগ করা
    if referrer_id and str(referrer_id).isdigit() and int(referrer_id) != user_id:
      ref_id = int(referrer_id)

      # রেফারকারী আগে থেকেই ডাটাবেসে আছে কিনা দেখা
      cursor.execute(
          "SELECT user_id FROM user_balances WHERE user_id = ?", (ref_id,)
      )
      if cursor.fetchone():
        cursor.execute(
            "INSERT INTO user_balances (user_id, balance, referred_by) VALUES"
            " (?, 0.0, ?)",
            (user_id, ref_id),
        )
        # রেফারকারীকে বোনাস প্রদান
        cursor.execute(
            "UPDATE user_balances SET balance = balance + ? WHERE user_id = ?",
            (REFERRAL_BONUS, ref_id),
        )
        rewarded_referrer = ref_id
      else:
        cursor.execute(
            "INSERT INTO user_balances (user_id, balance) VALUES (?, 0.0)",
            (user_id,),
        )
    else:
      cursor.execute(
          "INSERT INTO user_balances (user_id, balance) VALUES (?, 0.0)",
          (user_id,),
      )

  conn.commit()
  conn.close()
  return rewarded_referrer


def get_user_balance(user_id):
  conn = sqlite3.connect(DB_NAME)
  cursor = conn.cursor()
  cursor.execute(
      "SELECT balance FROM user_balances WHERE user_id = ?", (user_id,)
  )
  row = cursor.fetchone()
  conn.close()
  return row[0] if row else 0.0


def get_referral_count(user_id):
  conn = sqlite3.connect(DB_NAME)
  cursor = conn.cursor()
  cursor.execute(
      "SELECT COUNT(*) FROM user_balances WHERE referred_by = ?", (user_id,)
  )
  count = cursor.fetchone()[0]
  conn.close()
  return count


def save_submission(user_id, username, email, password):
  try:
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute(
        "INSERT INTO gmail_submissions (user_id, username, email, password)"
        " VALUES (?, ?, ?, ?)",
        (user_id, username or "NoUsername", email, password),
    )
    conn.commit()
    conn.close()
    return True, "সফলভাবে সেভ হয়েছে!"
  except sqlite3.IntegrityError:
    return False, "এই ইমেইলটি ইতিপূর্বে জমা দেওয়া হয়েছে!"
  except Exception as e:
    return False, f"ত্রুটি ঘটেছে: {str(e)}"


